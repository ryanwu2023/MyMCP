# Oracle（请复制为 .env 并填写真实值）
ORACLE_HOST=your_oracle_host
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=your_service_name
ORACLE_USER=your_readonly_user
ORACLE_PASSWORD=your_password
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5
ORACLE_CONNECT_TIMEOUT_SECONDS=10
ORACLE_CALL_TIMEOUT_MS=30000

# MCP HTTP
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8765
MCP_HTTP_PATH=/mcp
MCP_API_KEY=generate_a_random_value_with_at_least_32_characters
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,your_lan_ip:*

LOG_LEVEL=INFO
